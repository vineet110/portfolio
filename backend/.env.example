# Copy this file to .env and fill in real values. Never commit .env.

# SQLAlchemy connection string. Local Postgres example:
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/portfolio

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173

# Standard FastAPI/uvicorn environment name — "development" or "production".
ENVIRONMENT=development

# Email notification on new contact submissions — all optional. When any of
# these is missing, notification sending is skipped and contact submissions
# still succeed (see app/services/email_service.py).
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
NOTIFICATION_EMAIL=vineetp.work@gmail.com

# Optional external LLM for the Studio Assistant chatbot — all optional.
# When set, the LLM answers every message (general questions from its own
# knowledge, studio questions grounded in app/knowledge/). When unset or
# failing, studio questions are answered verbatim from app/knowledge/ and
# anything else gets a safe fallback. Supported providers: "groq" (active —
# free tier, model openai/gpt-oss-120b), "openai", "gemini" (see
# app/services/llm_service.py). For Gemini, use a current model such as
# gemini-3.5-flash-lite or gemini-3.8-flash — the 2.5 models are limited to
# projects that already used them. Server-side only: never put the key in a
# VITE_ variable or anywhere in frontend/.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
